{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Niuva Sonic",
  "version": "0.1.2",
  "identifier": "de.niuva.sonic",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Niuva Sonic",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/offline/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "foxy221",
    "copyright": "© 2026 foxy221",
    "category": "Music",
    "shortDescription": "Musik vom eigenen Navidrome-Server",
    "longDescription": "Niuva Sonic spielt die eigene Musiksammlung von einem Subsonic- oder Navidrome-Server ab: Bibliothek durchsuchen, Warteschlange verwalten, Favoriten und Playlists pflegen.",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/foxy221/niuva-sonic/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxQzRCRUE0RTYyQUE0MEYKUldRUHBDcm1wTDdFTVZ0VWdrRVg0MzFzZ1h3SnlmRkZsYmJGS2Q1MHBmbmpUMTZNSG0zTUJzankK"
    }
  }
}
